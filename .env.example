# ----------------------
# DATABASE
# ----------------------
DATABASE_URL=jdbc:postgresql://db:5432/lazydrop
DATABASE_USERNAME=lazydrop
DATABASE_PASSWORD=lazydrop

# ----------------------
# SUPABASE AUTH (REQUIRED)
# ----------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----------------------
# DIGITALOCEAN SPACES (REQUIRED)
# Use the REGION-ONLY endpoint — NOT the Space/bucket subdomain.
# Correct:   https://tor1.digitaloceanspaces.com
# Wrong:     https://my-space.tor1.digitaloceanspaces.com  (causes SSL cert error)
# ----------------------
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=

# ----------------------
# STRIPE (TEST KEYS)
# ----------------------
STRIPE_TEST_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PLUS=

# ----------------------
# APP
# ----------------------
APP_FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
APP_COOKIES_SECURE=false


